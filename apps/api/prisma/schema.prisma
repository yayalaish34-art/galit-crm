model LabSample {
  id                  String           @id @default(uuid())
  sampleNumber        String
  sampleType          LabSampleType    @default(OTHER)
  sampleStatus        LabSampleStatus  @default(COLLECTED)
  collectedAt         DateTime?
  receivedAt          DateTime?
  analyzedAt          DateTime?
  locationDescription String?
  testType            String?
  method              String?
  resultValue         String?
  resultUnit          String?
  resultStatus        LabResultStatus  @default(PENDING)
  resultFilePath      String?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  projectId           String?
  project             Project?         @relation(fields: [projectId], references: [id])

  customerId          String?
  customer            Customer?        @relation(fields: [customerId], references: [id])

  collectedById       String?
  collectedBy         User?            @relation("LabSampleCollector", fields: [collectedById], references: [id])
}

model SystemSetting {
  key        String   @id
  value      Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model QuoteItemCatalog {
  id               String   @id @default(uuid())
  itemCode         String   @unique
  name             String
  description      String?
  serviceCategory  String?
  serviceSubType   String?
  costPrice        Float    @default(0)
  basePrice        Float    @default(0)
  profitPercent    Float?
  billingUnit      String
  vatPercent       Float    @default(17)
  isActive         Boolean  @default(true)
  requiresQuantity Boolean  @default(true)
  requiresSiteVisit Boolean @default(false)
  requiresReport   Boolean  @default(false)
  notes            String?
