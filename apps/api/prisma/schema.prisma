model Quote {
  id          String       @id @default(uuid())
  importLegacyId String?
  quoteNumber String?
  service     String
  description String?
  // Legacy amount (kept); spec uses amountBeforeVat + vatPercent + discount
  amount      Float
  status      QuoteStatus  @default(DRAFT)
  validTo     DateTime
  pdfPath     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id])

  customerContactId String?
  customerContact   CustomerContact? @relation(fields: [customerContactId], references: [id])

  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id])

  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])

  opportunityId           String?
  opportunity             Opportunity? @relation(fields: [opportunityId], references: [id])

  // Spec-aligned quote fields
  validityDate            DateTime?
  amountBeforeVat         Float?     @default(0)
  vatPercent              Float?     @default(17)
  discountType            DiscountType @default(NONE)
  discountValue           Float?     @default(0)
  totalAmount             Float?     @default(0)
  paymentTerms            String?
  notes                   String?
  digitalSignatureStatus  DigitalSignatureStatus @default(NOT_REQUESTED)

  // Automation helpers
  sentAt                  DateTime?
  reminderNextAt          DateTime?
  reminderCount           Int?       @default(0)

  // Origami preparation (no integration yet)
  signedPdfPath           String?
  digitalCertificateMeta  Json?
  signatureRequestedAt    DateTime?
  signedAt                DateTime?

  quoteTemplateId String?
  quoteTemplate   QuoteTemplate? @relation(fields: [quoteTemplateId], references: [id], onDelete: SetNull)
  /// גוף HTML ממוזג לתצוגה מקדימה / PDF עתידי
  contentHtml     String? @db.Text
  /// פריטי שורה שנשמרו מהתבנית/עריכה
  lineItemsJson   Json?

  // ── Fields added by migrations 20260325181000 / 183500 / 190000 ──────────
  customerName            String?
  quoteDate               DateTime?
  followupDate            DateTime?
  salesRepresentativeName String?
  executorName            String?
  /// המשימה שמטפלת בהצעה. היה String חופשי ללא FK וללא אינדקס, ולכן הצטברו מצביעים
  /// למשימות שנמחקו (10 בייצור) — והמנעול "ההצעה כבר מקושרת למשימה" ראה ערך לא-ריק
  /// ודילג, או נדרס למשימה החדשה ונטש את הקודמת. שתיהן דרכים לשתי משימות על הצעה אחת.
  /// onDelete: SetNull — מחיקת משימה מנקה את הקישור במקום להשאיר מצביע מת.
  linkedEntityId          String?
  linkedTask              Task?     @relation("QuoteLinkedTask", fields: [linkedEntityId], references: [id], onDelete: SetNull)
  orderReferenceNumber    String?
  copiedFromOrder         String?
  priceList               String?
  exchangeRate            Decimal?  @db.Decimal(18, 4)
  accountingNumber        String?
  companyRegNumber        String?
  addressSummary          String?
  citySummary             String?
  phoneSummary            String?
  faxSummary              String?
  validityDays            Int?
  paymentsCount           Int?
  paymentAmount           Decimal?  @db.Decimal(18, 2)
  paymentFactor           Decimal?  @db.Decimal(18, 4)
  paymentTotal            Decimal?  @db.Decimal(18, 2)
  paymentReference        String?
  paymentDueDate          DateTime?
  paymentStatus           String?
  internalNotes           String?
  openingText             String?
  closingText             String?
  orderSource             String?
  functionalLabel         String?
  closeProbabilityPercent String?
  closeColor              String?
  lastUpdatedBy           String?
  lastUpdatedDate         DateTime?
  lastUpdatedTime         String?
  forecastFunctionalLabel String?
  forecastClosePercent    String?
  forecastColor           String?
  forecastUpdatedAt       DateTime?
  forecastUpdatedBy       String?
  forecastUpdatedTime     String?

  // ── User FK relations for sales rep + performer (20260328190000) ─────────
  salesRepresentativeId   String?
  salesRepresentative     User?   @relation("QuoteSalesRep", fields: [salesRepresentativeId], references: [id], onDelete: SetNull)
  performerUserId         String?
  performerUser           User?   @relation("QuotePerformer", fields: [performerUserId], references: [id], onDelete: SetNull)
  performerName           String?

  followUpResponsibleUserId String?
  followUpResponsibleUser   User?   @relation("QuoteFollowUpResponsible", fields: [followUpResponsibleUserId], references: [id], onDelete: SetNull)

  /// נתיב למסמך הממוזג האחרון שהופק להצעה זו
  lastMergedDocPath         String?
  /// מעקב שליחת מייל אחרונה
  lastEmailedAt             DateTime?
  lastEmailedTo             String?
  /// תוכן מייל הצעת המחיר האחרון שנשלח — נשמר כדי לנסח ממנו את מייל הדוח בשלב 7
  lastEmailSubject          String?
  lastEmailBody             String?   @db.Text

  /// OneDrive — מסמך DOCX ניתן-לעריכה ב-Word עם שמירה-חזרה אוטומטית.
  /// onedriveItemId: מזהה הפריט ב-OneDrive; onedriveWebUrl: כתובת פתיחה ב-Word;
  /// onedriveOwnerId: המשתמש שב-OneDrive שלו הקובץ מאוחסן (נדרש למשיכת הגרסה בזמן שליחה).
  onedriveItemId            String?
  onedriveWebUrl            String?
  onedriveOwnerId           String?
  /// ה-TaskAttachment שנפתח לעריכה ב-Word (עריכה פר-קובץ) — הסנכרון-חזרה מעדכן אותו, לא את החדש ביותר.
  onedriveAttachmentId      String?
  /// המשתמש ערך ידנית את שם הקובץ → השם הידני מנצח. הסנכרון האוטומטי (renameOnedriveToMatch)
  /// לא ידרוס שם ידני ב-OneDrive כל עוד הדגל דלוק.
  onedriveNameLocked        Boolean  @default(false)

  salesOrders     SalesOrder[]
  quoteItems      CustomerQuoteItem[]
  quoteDocuments  QuoteDocument[]

  @@index([importLegacyId])
  @@index([salesRepresentativeId])
  @@index([performerUserId])
  @@index([followUpResponsibleUserId])
  @@index([linkedEntityId])
}

model Task {
  id          String        @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus    @default(OPEN)
  /// שלב בצינור הזרימה: step1..step7 (פתיחת פנייה → דוח). מסונכרן עם currentStage.
  type        String        @default("step1")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId     String
  owner       User          @relation("TaskOwner", fields: [ownerId], references: [id])

  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id])

  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id])

  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])

  productName          String?
  currentStage         Int?
  currentStageChangedAt DateTime?

  /// אם מקורו של ה-task בליד נכנס מהמייל — מזהה ה-IncomingLead (לסידור-ראשון ולטופס המיוחד).
  /// @unique = בלם DB נגד כפילות: לליד נכנס יש משימת-תהליך אחת בדיוק. ב-Postgres ערכי NULL
  /// אינם מתנגשים זה בזה, כך שכל המשימות שאינן מליד נכנס אינן מושפעות.
  incomingLeadId       String?  @unique

  /// מתי המשימה הועברה לבעלים הנוכחי ("העבר לעובד"/העברת ליד). נדרש כדי שמשימת
  /// "ליד חדש נכנס" שהועברה תופיע בראש הרשימה של מי שקיבל אותה, גם אחרי שנפתח כרטיס לקוח.
  transferredAt        DateTime?

  /// הערות כלליות על התהליך/הלקוח לאורך הזרימה — מערך JSON של { text, at } (הכי חדש בראש)
  processNotes         String?

  attachments TaskAttachment[]
  taskField   TaskField?
  /// בקשות אישור מנהל שנפתחו על המשימה (לקוח פרטי שטרם שילם)
  approvalRequests ApprovalRequest[] @relation("TaskApprovalRequests")
  /// הצעות המחיר שמקושרות למשימה (Quote.linkedEntityId). לא unique בכוונה — למשימה
  /// אחת יכולות להיות כמה הצעות (גרסאות/סבבים); מה שאסור הוא ההפך, שתי משימות להצעה.
  linkedQuotes Quote[] @relation("QuoteLinkedTask")

  @@index([incomingLeadId])
}

/// נתוני שדה לפגישה — מוזן בשלב תיאום פגישה בעת לחיצה על "צור פגישה ב-Outlook"
model TaskField {
  id                   String    @id @default(uuid())
  taskId               String    @unique
  task                 Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  inspectionTypeId     String?
  family               String?

  appointmentTitle     String?
  scheduledStartAt     DateTime?
  scheduledEndAt       DateTime?
  durationMinutes      Int?

  workerNotifiedAt     DateTime?

  siteAddress          String?
  siteCity             String?
  fieldContactName     String?
  fieldContactPhone    String?
  navigationUrl        String?
  specialInstructions  String?   @db.Text

  fieldStatus          String    @default("ASSIGNED")
  assignedAt           DateTime  @default(now())
  confirmedAt          DateTime?
  declinedAt           DateTime?
  declinedReason       String?
  departedAt           DateTime?
  arrivedAt            DateTime?
  finishedAt           DateTime?

  fieldNotes           String?   @db.Text
  problemType          String?
  problemNote          String?   @db.Text
  hasOpenProblem       Boolean   @default(false)

  missingReportInfo    Boolean   @default(false)
  missingReportInfoNote String?  @db.Text
  managerNotifiedAt    DateTime?

  /// אוטומציית "הנחיות לפני הבדיקה" — רלוונטית רק לבדיקות איכות אוויר (קודים 72 / 69).
  /// preVisitEmailDueAt = 09:00 ביום שלפני מועד הבדיקה; ה-cron שולח כשהגיע המועד
  /// וחותם preVisitEmailSentAt כדי שלא יישלח פעמיים.
  preVisitEmailEnabled Boolean   @default(false)
  preVisitEmailSku     String?
  preVisitEmailDueAt   DateTime?
  preVisitEmailSentAt  DateTime?
  preVisitEmailError   String?   @db.Text

  updatedByUserId      String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([taskId])
  /// לסריקת ה-cron של "הנחיות לפני הבדיקה" — שליפת מיילים שהגיע מועדם וטרם נשלחו.
  @@index([preVisitEmailEnabled, preVisitEmailSentAt, preVisitEmailDueAt])
}

/// קבצים מצורפים למשימה (למשל: מסמך הצעת מחיר ממוזג) — נשמרים ישירות ב-DB כך שיישארו זמינים תמיד
model TaskAttachment {
  id        String   @id @default(uuid())
