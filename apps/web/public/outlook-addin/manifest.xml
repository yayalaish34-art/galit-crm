<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>5c45d94e-cc6e-4e23-9a3e-532fded25b77</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Galit CRM</ProviderName>
  <DefaultLocale>he-IL</DefaultLocale>

  <DisplayName DefaultValue="My CRM" />
  <Description DefaultValue="שמירת הודעות Outlook במערכת My CRM" />

  <IconUrl DefaultValue="https://crm.galit.co.il/outlook-addin/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://crm.galit.co.il/outlook-addin/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://crm.galit.co.il" />

  <AppDomains>
    <AppDomain>https://crm.galit.co.il</AppDomain>
    <AppDomain>https://galit.up.railway.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://crm.galit.co.il/outlook-addin/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- ReadWriteItem נדרש לתיוק בזמן כתיבה: saveAsync (שמירת טיוטה כדי לקבל
       itemId לדדופ) אינו זמין תחת ReadItem בלבד. -->
  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="ReadOrEdit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- הפעלת פונקציה ישירה (ExecuteFunction) — טעינת commands.html -->
          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="galitCrmGroup">
                <Label resid="Group.Label" />

                <!-- כפתור 1: הוספה ל-CRM (ExecuteFunction, בלי חלון צד) -->
                <Control xsi:type="Button" id="addToCrmButton">
                  <Label resid="AddToCrm.Label" />
                  <Supertip>
                    <Title resid="AddToCrm.Label" />
                    <Description resid="AddToCrm.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>addCurrentEmailToCrm</FunctionName>
                  </Action>
                </Control>

                <!-- כפתור 2: פתיחת My CRM (ShowTaskpane) -->
                <Control xsi:type="Button" id="openCrmButton">
                  <Label resid="OpenCrm.Label" />
                  <Supertip>
                    <Title resid="OpenCrm.Label" />
                    <Description resid="OpenCrm.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- ── בזמן כתיבת מייל — תיוק המייל היוצא לכרטיס הלקוח ──
               השרת משייך אותו לפי הנמענים (direction=OUTGOING), כי השולח הוא
               העובד שלנו ולא הלקוח. -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="galitCrmComposeGroup">
                <Label resid="Group.Label" />
                <Control xsi:type="Button" id="fileComposeButton">
                  <Label resid="FileCompose.Label" />
                  <Supertip>
                    <Title resid="FileCompose.Label" />
                    <Description resid="FileCompose.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>fileComposeEmailToCrm</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://crm.galit.co.il/outlook-addin/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://crm.galit.co.il/outlook-addin/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://crm.galit.co.il/outlook-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://crm.galit.co.il/outlook-addin/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://crm.galit.co.il/outlook-addin/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="My CRM" />
        <bt:String id="AddToCrm.Label" DefaultValue="הוספה ל-CRM" />
        <bt:String id="OpenCrm.Label" DefaultValue="פתיחת My CRM" />
        <bt:String id="FileCompose.Label" DefaultValue="תייק לכרטיס לקוח" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="AddToCrm.Tooltip" DefaultValue="שמירת המייל הנוכחי כבקשה במערכת My CRM" />
        <bt:String id="OpenCrm.Tooltip" DefaultValue="פתיחת חלון My CRM לצד ההודעה" />
        <bt:String id="FileCompose.Tooltip" DefaultValue="תיוק המייל היוצא לכרטיס הלקוח, תחת טאב הבקשות" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
