  updatedAt        DateTime @updatedAt
}

/// תנאי תשלום (20260328120000_payment_terms)
model PaymentTerm {
  id        String   @id @default(uuid())
  label     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// שורות פריטי ההצעה (20260325181000)
model CustomerQuoteItem {
  id                  String   @id @default(uuid())
  quoteId             String
  quote               Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rowOrder            Int      @default(0)
  productCode         String?
  sku                 String?
  productDescription  String?
  distributionChannel String?
  quantity            Decimal? @db.Decimal(18, 4)
  price               Decimal? @db.Decimal(18, 2)
  discountPercent     Decimal? @db.Decimal(6, 2)
  total               Decimal? @db.Decimal(18, 2)
  totalIls            Decimal? @db.Decimal(18, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([quoteId])
  @@index([rowOrder])
}

/// מסמכים מקושרים להצעה (20260325183500)
model QuoteDocument {
  id                  String    @id @default(uuid())
  quoteId             String
  quote               Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  importLegacyId      String?
  rowOrder            Int       @default(0)
  documentDescription String?
  documentType        String?
  fileName            String?
  filePath            String?
  /// תוכן הקובץ נשמר ישירות ב-DB כך שישרוד deploys (דיסק Railway זמני). אופציונלי — רשומות ישנות עם filePath בלבד.
  data                Bytes?
  mimeType            String?
  documentDate        DateTime?
  uploadedBy          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([quoteId])
  @@index([importLegacyId])
}

