generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  name         String
  email    String   @unique
  /// Bcrypt hash; DB column remains "passwordHash" for existing migrations.
  password String   @map("passwordHash")
  role     UserRole @default(SALES)
  status       UserStatus  @default(ACTIVE)
  phone        String?
  /// מספרי וואטסאפ נוספים לאותו משתמש (מכשירים נוספים) — ראה model UserPhone.
  extraPhones  UserPhone[]
  department   String?
  // Multi-select service ownership (used for lead routing)
  serviceDepartments String[] @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Basic per-user permissions overrides (stage 1 of permissions system)
  canViewFinance         Boolean @default(false)
  canEditFinance         Boolean @default(false)
  canDeleteCustomers     Boolean @default(false)
  canDeleteLeads         Boolean @default(false)
  canManageUsers         Boolean @default(false)
  canManagePermissions   Boolean @default(false)
  canViewAllRecords      Boolean @default(false)

  ownedLeads       Lead[]    @relation("LeadAssignedUser")
  tasks            Task[]    @relation("TaskOwner")
  reports          Report[]  @relation("ReportCreator")
  reviewedReports  Report[]  @relation("ReportReviewer")
  uploadedDocuments Document[] @relation("DocumentUploader")
  collectedSamples LabSample[] @relation("LabSampleCollector")
  assignedProjects Project[] @relation("ProjectTechnician")
  writtenReports   Project[] @relation("ProjectReportWriter")
  opportunities    Opportunity[]
  workStatus       WorkStatus  @default(OFFLINE)

  // Presence (simple heartbeat-based tracking)
  isOnline         Boolean     @default(false)
  lastSeenAt       DateTime?
  currentWorkMode  WorkMode?
  currentProjectId String?
  currentProject   Project?    @relation("UserCurrentProject", fields: [currentProjectId], references: [id])

  leadActivitiesCreated LeadActivity[]
  /// "לקוחות אחרונים" — לקוחות שהעובד נכנס אליהם לאחרונה (ראה model CustomerView)
  customerViews         CustomerView[]
  /// מספר עובד (20260327000000_add_employee_number)
  employeeNumber        String?

  // ── הגדרות SMTP אישיות לשליחת מייל ──
  mailDisplayName       String?
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  /// מוצפן ב-AES-256 — לא מוחזר ל-frontend
  smtpPassword          String?
  smtpFrom              String?
  smtpSecure            Boolean   @default(false)

  // ── Microsoft Graph (Outlook) — שליחת מייל בשם המשתמש ──
  /// כתובת המייל של תיבת ה-Outlook המחוברת (לתצוגה)
  msEmail               String?
  /// refresh token מוצפן ב-AES-256 — לא מוחזר ל-frontend
  msRefreshToken        String?
  /// מתי המשתמש חיבר את חשבון ה-Outlook
  msConnectedAt         DateTime?
  // ── OneDrive נפרד — חשבון Microsoft שונה מ-Outlook, לאחסון קבצים בלבד (CRM-Quotes) ──
  /// כתובת המייל של חשבון ה-OneDrive הנפרד (לתצוגה). null = משתמשים בחשבון ה-Outlook הרגיל.
  odEmail               String?
  /// refresh token מוצפן ב-AES-256 של חשבון ה-OneDrive הנפרד — לא מוחזר ל-frontend
  odRefreshToken        String?
  /// מתי המשתמש חיבר את חשבון ה-OneDrive הנפרד
  odConnectedAt         DateTime?
  /// חתימת מייל אישית — מתווספת אוטומטית לגוף הצעות מחיר שנשלחות
  mailSignature         String?
  /// תמונת חתימה (לוגו/חתימה סרוקה) — מוטמעת בגוף המייל מתחת לטקסט
  /// LEGACY: חתימה בודדת. נשמר לתאימות לאחור; חתימות מרובות נשמרות ב-UserSignature
  mailSignatureImage    Bytes?
  mailSignatureImageType String?
  /// חתימות מרובות (תמונה + כותרת) — העובד בוחר את המתאימה בעת שליחת הצעה
  signatures            UserSignature[] @relation("UserSignatures")
  /// לידים נכנסים מהמייל שמשויכים למשתמש (owner)
  incomingLeads         IncomingLead[]  @relation("IncomingLeadOwner")
  salesRepQuotes        Quote[] @relation("QuoteSalesRep")
  performerQuotes       Quote[] @relation("QuotePerformer")
  followUpQuotes        Quote[] @relation("QuoteFollowUpResponsible")
  /// בקשות אישור מנהל שהעובד הזה שלח
  approvalRequests      ApprovalRequest[] @relation("ApprovalRequester")
  /// בקשות אישור מנהל שהמשתמש הזה אישר/דחה
  approvalDecisions     ApprovalRequest[] @relation("ApprovalDecider")
}

/// בקשת אישור מנהל — נוצרת כשעובד מבקש להמשיך בשלב שחסום לו.
///
/// המקרה היחיד כרגע: לקוח פרטי שטרם שילם — העובד לא יכול לעבור לשלב הביצוע
/// ולא יכול לשלוח את הדוח בלי אישור של יורם/גיא. הבקשה נוצרת מהפופ-אפ בצד
/// העובד, מופיעה למנהלים במסך ההתראות, ורק אחרי APPROVED העובד משוחרר להמשיך.
///
/// ייחודיות: אין יותר מבקשה PENDING אחת לאותו (taskId, kind) — נאכף באינדקס
/// חלקי במיגרציה, כדי שלחיצות חוזרות לא ייצרו ערימת בקשות כפולות.
model ApprovalRequest {
  id           String                @id @default(uuid())
  kind         ApprovalKind
  status       ApprovalStatus        @default(PENDING)
  /// המשימה שעליה מבוקש האישור
  taskId       String
  task         Task                  @relation("TaskApprovalRequests", fields: [taskId], references: [id], onDelete: Cascade)
  /// הלקוח (לתצוגה למנהל — שם/סוג); nullable כי משימה יכולה להיות בלי לקוח משויך
  customerId   String?
  /// snapshot לתצוגה, כדי שמסך המנהל לא יצטרך לטעון משימות/לקוחות
  customerName String?
  taskTitle    String?
  /// סיבת הבקשה כפי שהוצגה לעובד (למשל "לקוח פרטי שטרם שילם")
  reason       String?               @db.Text
  requesterId  String
  requester    User                  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  /// מי הכריע (אישר/דחה)
  deciderId    String?
  decider      User?                 @relation("ApprovalDecider", fields: [deciderId], references: [id])
  decidedAt    DateTime?
  /// הערת המנהל בדחייה (מוצגת לעובד)
  decisionNote String?               @db.Text
  /// מתי הוקפצה התראה למנהל (כדי לא להקפיץ שוב)
  notifiedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status])
  @@index([taskId])
  @@index([requesterId])
}

enum ApprovalKind {
  /// מעבר לשלב הביצוע ללקוח פרטי שטרם שילם
  EXEC_UNPAID_PRIVATE
  /// שליחת הדוח ללקוח פרטי שטרם שילם
  REPORT_UNPAID_PRIVATE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// מספרי וואטסאפ נוספים למשתמש (מכשיר שני/שלישי וכו').
///
/// למה: זהות בבוט הוואטסאפ נקבעת לפי טלפון → שורת "User". פתיחת שורת משתמש
/// נוספת עבור מכשיר שני הייתה מפצלת את הזהות — userId אחר פירושו משימות אחרות
/// *וחיבור Outlook אחר* (ה-CRM שומר את חיבור היומן לפי userId). טבלה זו שומרת
/// על userId אחד, ולכן כל המספרים מגיעים לאותן משימות ולאותו יומן.
///
/// אבטחה: מספר שמופיע כאן מקבל את מלוא ההרשאות של המשתמש (תפקיד, הרשאות,
/// וקריאה/כתיבה/מחיקה ביומן ה-Outlook שלו). להוסיף רק מספרים של אותו אדם.
///
/// phoneDigits מאוחסן מנורמל (ספרות בלבד, פורמט 972XXXXXXXXX) כדי שהחיפוש
/// יהיה ודאי ולא תלוי בפורמט הכתיבה (מקפים/רווחים/+/0 מוביל).
model UserPhone {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// המספר כפי שהוזן, לתצוגה בלבד (למשל "+972 53-774-0988").
  phone       String
  /// ספרות בלבד, מנורמל ל-972XXXXXXXXX. זהו שדה החיפוש בפועל.
  phoneDigits String   @unique
  /// תיאור חופשי, למשל "טלפון חברה" / "מכשיר שני".
  label       String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// חתימת מייל מרובה למשתמש — תמונה + כותרת. מאפשר לעובד להחזיק כמה חתימות
/// (לפי שירות/הקשר) ולבחור את הנכונה בעת שליחת הצעת מחיר.
model UserSignature {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserSignatures", fields: [userId], references: [id], onDelete: Cascade)
  /// כותרת לזיהוי החתימה (למשל "חתימה כללית", "בדיקות מים", "קרינה")
  title     String
  /// בייטים של תמונת החתימה
  image     Bytes
  imageType String   @default("image/png")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// ליד נכנס שזוהה אוטומטית ממייל ב-Outlook (נושא המכיל "ליד").
/// משמש כמקור-אמת לפרטי הליד; ה-Task שנוצר ממנו מופיע ראשון ברשימת המשימות.
model IncomingLead {
  id              String             @id @default(uuid())
  /// מזהה ההודעה ב-Graph (פר-תיבה) — ייחודי, מונע יצירה כפולה לאותו משתמש
  messageId       String             @unique
  /// Message-ID מ-RFC 5322 — זהה בכל תיבות הנמענים; משמש לקיבוץ אותו מייל בין עובדים.
  /// @unique = "ליד אחד משותף": אותו מייל שהגיע ל-5 תיבות ייכנס כשורה אחת. duplicateOfExistingLead
  /// לבדו הוא check-then-act ולכן לא עמד בסריקות מקבילות (נוצרו עד 6 עותקים לאותו מייל).
  internetMessageId String?            @unique
  subject         String
  /// גוף המייל = פרטי הליד שהוזנו
  body            String?
  fromName        String?
  fromEmail       String?
  receivedAt      DateTime
  status          IncomingLeadStatus @default(NEW)
  /// בעל הטיפול הנוכחי (מי שקיבל את המייל, או מי שהועבר אליו)
  ownerId         String
  owner           User               @relation("IncomingLeadOwner", fields: [ownerId], references: [id])
  /// אם הועבר — מזהה העובד שאליו הועבר (לתיעוד)
  transferredToId String?
  /// ה-Task שנוצר עבור הליד
  taskId          String?
  /// מתי הוצגה התראה צידית (כדי לא להקפיץ שוב)
  notifiedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([internetMessageId])
}

enum IncomingLeadStatus {
  NEW          // הגיע, ממתין — מוצג טופס "התחל טיפול / העבר"
  ACTIVE       // התחיל טיפול או הועבר — מוצג ישירות עם פרטי הליד
  DISMISSED    // נדחה
}

model Project {
  id                    String         @id @default(uuid())
  /// מזהה ייחודי מהמערכת המיובאת (לקישור בין ישויות בייבוא)
  importLegacyId        String?
  projectNumber         String?
  name                  String
  client                String
  status                ProjectStatus  @default(NEW)
  progress              Int            @default(0)
  dueDate               DateTime?
  siteVisitDate         DateTime?
  siteVisitTime         String?
  city                  String?
  address               String?
  service               String?
  serviceCategory       String?
  serviceSubType        String?
  contactName           String?
  contactPhone          String?
  urgency               String?
  fieldContactName      String?
  fieldContactPhone     String?
  requiresReport        Boolean        @default(true)
  requiresSampling      Boolean        @default(false)
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id])

  assignedTechnicianId  String?
  assignedTechnician    User?          @relation("ProjectTechnician", fields: [assignedTechnicianId], references: [id])

  assignedReportWriterId String?
  assignedReportWriter   User?         @relation("ProjectReportWriter", fields: [assignedReportWriterId], references: [id])

  tasks                 Task[]
  quotes                Quote[]
  reports               Report[]
  documents             Document[]
  labSamples            LabSample[]

  // Presence: which users selected this as current project
  activeUsers           User[]         @relation("UserCurrentProject")

  leads                 Lead[]

  @@index([importLegacyId])
}

model CustomerClassification {
  id        String   @id @default(uuid())
  code      String   @unique
  labelHe   String
  sortOrder Int      @default(0)
  isPreset  Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// מקורות הגעה ("מקור הגעה") הניתנים-לעריכה — נוספים דרך "אחר" בטופס פתיחת פנייה ונשמרים לתמיד.
model LeadSource {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isPreset  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Customer {
  id          String         @id @default(uuid())
  /// מזהה מהמערכת המיובאת (לקישור בין לידים/דוחות/פרויקטים)
  importLegacyId String?
  /// ה-ContactId של הלקוח בכספית. נפתר פעם אחת (התאמה ללקוח קיים או יצירה) ונשמר,
  /// כדי שהנפקות הבאות לא ייצרו כרטיס כפול ולא יסרקו שוב את כל אנשי הקשר.
  caspitContactId String?
  name        String
  /// שם חברה / מוסד — חובה כשסיווג לקוח אינו PRIVATE
  companyname String?
  /// סיווג לקוח: קוד מתוך CustomerClassification (למשל COMPANY / C_...)
  type        String
  contactName String
  phone       String
  email       String
  city        String
  address     String?
  status      String         @default("ACTIVE")
  services    String[]
  notes       String?
  /// מקור הגעה של הלקוח (נשמר מטופס "פתיחת פנייה" / כרטיס הלקוח)
  leadSource  String?
  /// שדות מיובאים Followup / מערכת ישנה
  phone2           String?
  phone3           String?
  fax              String?
  website          String?
  companyRegNumber String?
  internalNotes    String?    @db.Text
  balanceLegacy    Decimal?   @db.Decimal(18, 2)
  birthdayLegacy   DateTime?
  cityCodeLegacy   String?
  zipLegacy        String?
  legacyUpdatedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// Legacy customer card — general / account
  legacyAccountNumber         String?
  legacySubClassificationCode String?
  salesRepresentative         String?
  functionalLabel             String?
  customerSize                String?
  managementProfile           String?
  countryOrRegion             String?

  /// Legacy card — mailing (פרטי דיוור)
  mailingAddress      String?
  mailingCity         String?
  mailingZip          String?
  mailingPoBox        String?
  mailingInvalidField String?
  allowMail           Boolean?
  allowFax            Boolean?
  allowEmail          Boolean?
  allowSms            Boolean?
  mailingNote         String? @db.Text

  /// Legacy card — notes tab metadata
  registrationDate DateTime?
  registrationNote String?   @db.Text
  lastUpdateDate   DateTime?
  lastUpdateNote   String?   @db.Text
  lastUpdatedBy    String?

  /// Legacy card — financial (single record on customer)
  priceList               String?
  roundedPricing          String?
  employeeCount           String?
  managementCustomerLabel String?
  financialNumber1        String?
  financialNumber2        String?
  financialNumber2Large   String?
  financialNumber3        String?
  financeToken            String?
  financeTokenDate        DateTime?
  financeTokenActive      Boolean?
  financeUnnamed1         String?
  financeUnnamed2         String?
  financeUnnamed3         String?
  financeUnnamed4         String?
  totalPurchases          Decimal? @db.Decimal(18, 2)
  totalSales              Decimal? @db.Decimal(18, 2)
  percentageValue         Decimal? @db.Decimal(18, 4)
  paymentTerms            String?
  creditDays              String?
  creditEnabled           Boolean?
  creditNumber            String?
  creditExpiry            String?

  /// אוטומציית משוב ופולואו-אפ (לכל לקוח) — נשלט מסקשן "משוב"
  /// משוב: חותמת זמן של בקשת המשוב האחרונה שנשלחה (למניעת כפילויות)
  feedbackRequestedAt DateTime?
  /// משוב: החרגת הלקוח משליחה אוטומטית של בקשת משוב
  feedbackOptOut      Boolean?
  /// פולואו-אפ: הפעלת פולואו-אפ אוטומטי ללקוח הספציפי הזה
  autoFollowupEnabled Boolean?
  /// פולואו-אפ: מרווח ימים מותאם אישית (דורס את הגלובלי)
  followupIntervalDays Int?
  /// פולואו-אפ: ערוץ ('email' | 'sms') — אם ריק, ברירת המחדל הגלובלית
  followupChannel      String?
  /// פולואו-אפ: מתי נשלח לאחרונה / מתי הבא צפוי
  lastFollowupAt       DateTime?
  nextFollowupAt       DateTime?

  /// סיווג "לא רלוונטי" — נקבע כשעובד מסמן משימה כלא רלוונטית
  /// קטגוריית הסיבה (יקר מדי / אי-התאמה בשירות / לא מעוניין / זמן לא טוב / לא ניתן ליצור קשר / אחר)
  notRelevantReason   String?
  /// פירוט חופשי (בעיקר עבור "אחר")
  notRelevantNote     String?
  /// מתי סווג כלא רלוונטי
  notRelevantAt       DateTime?

  /// Legacy card — פרטים נוספים
  microwaveModel   String?
  detectorLocation String?
  companyAmount    String?
  feature7         String?
  detailDate1      DateTime?
  detailDate3      DateTime?
  detectorModel    String?
  feature4         String?
  companyWall      String?
  feature8         String?
  detailDate2      DateTime?
  detailDate4      DateTime?

  leads       Lead[]
  quotes      Quote[]
  tasks       Task[]
  reports     Report[]
  projects    Project[]
  opportunities Opportunity[]
  documents   Document[]
  labSamples  LabSample[]
  contacts         CustomerContact[]
  salesOrders      SalesOrder[]
  interactions     CustomerInteraction[]
  referralSources        CustomerReferralSource[]
  customerQuestionnaires CustomerQuestionnaire[]
  customerRelations      CustomerRelation[]
  additionalDataRows     CustomerAdditionalDataRow[]
  externalDataRows       CustomerExternalDataRow[]
  blocks                 CustomerBlock[]
  views                  CustomerView[]
  emailRequests          CustomerEmailRequest[]

  @@index([importLegacyId])
  @@index([name])
  @@index([phone])
}

/// "לקוחות אחרונים" per-user — נרשם/מתעדכן ברגע שעובד נכנס לכרטיס לקוח (או למשימה
/// המשויכת ללקוח). upsert על (userId, customerId): viewedAt = now. משמש להצגת
/// 10 הלקוחות האחרונים שהעובד נגע בהם, ולא לפי createdAt.
model CustomerView {
  id         String   @id @default(uuid())
  userId     String
  customerId String
  viewedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([userId, customerId])
  @@index([userId, viewedAt])
}

/// ערוצי תקשורת שניתן לחסום ("חסום ל:") — נפרד מהעדפות הדיוור (allow*).
enum BlockChannel {
  MAILING  // דיוור
  WHATSAPP // ווצאפ
  EMAIL    // דוא"ל
  SMS      // SMS
}

/// חסימת ערוץ תקשורת ללקוח — שורה אחת לכל ערוץ חסום. מוצג בכרטיס הלקוח.
model CustomerBlock {
  id         String       @id @default(uuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    BlockChannel
  /// סיבת החסימה (אופציונלי)
  reason     String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  /// לקוח לא יכול להיחסם פעמיים לאותו ערוץ.
  @@unique([customerId, channel])
